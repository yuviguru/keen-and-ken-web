RESEND_API_KEY=re_your_api_key_here
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GITHUB_TOKEN=github_pat_your_token_here
GROQ_API_KEY=gsk_your_groq_api_key_here

# Lead Rescue dogfood wiring (services/keen-and-ken/) - the n8n webhook's production URL
# once the "Webhook Intake" node in services/keen-and-ken/n8n-workflow.json is imported and activated.
LEAD_RESCUE_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-rescue-intake-keen-and-ken

# Keen & Ken voice widget (src/lib/voice/, src/lib/reasoning/) - see
# docs/keen-and-ken-voice-architecture.md in the yuvi-ventures repo for the
# full provider/cost design this config drives. Explicit selection by
# name, not implicit key presence, is intentional (architecture doc 6.3).
VOICE_PROVIDER=gemini-live            # gemini-live | openai-realtime | elevenlabs | self-hosted
VOICE_FALLBACK_PROVIDER=openai-realtime
VOICE_MAX_TURNS=6

REASONING_PROVIDER=claude             # claude | gpt | gemini | grok | groq-llama
REASONING_FALLBACK_PROVIDER=groq-llama

GEMINI_LIVE_API_KEY=
OPENAI_REALTIME_API_KEY=
ANTHROPIC_API_KEY=

# Keen & Ken voice widget backend (src/app/api/keen/session-end) - Airtable Pipeline write.
# Base ID (app7vPYci5zFCGHz4) and table ID (tblCA4vxxTUYPRlTA) are not secret (already in
# cleartext across docs/sales/ and the n8n workflow configs in this org) and are hardcoded in
# the route; only the API key is an env var.
AIRTABLE_API_KEY=pat_your_airtable_personal_access_token_here
